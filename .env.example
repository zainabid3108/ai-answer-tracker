# Copy to .env and edit. Placeholders only - never commit real secrets.
# NODE_ENV is REQUIRED - there is no default. Allowed values (case-sensitive): development, test, production.
# API and worker refuse to start if it is missing or invalid. The value below is only a placeholder for local work.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=ai_answer_tracker
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=aat

# STUB AUTH (placeholder - revisit before production): comma-separated apiKey:tenantId
# tenantId: letters, digits, '_' and '-' only (1-64 chars). Keys must be unique.
# In production every key must be at least 32 characters (generate random values; never reuse this placeholder).
API_KEYS=replace-me-dev-key:tenant-demo

# Provider mode: mock (default in dev/test) or real. Real adapters do not exist yet, so real fails fast at startup.
PROVIDER_MODE=mock
# Production refuses PROVIDER_MODE=mock unless this is explicitly true (logs a loud warning). Leave false.
ALLOW_MOCK_IN_PRODUCTION=false
# Enables [[mock:...]] prompt directives for tests/dev. Refused when NODE_ENV=production.
ENABLE_MOCK_FAILURE_INJECTION=false
# Real provider keys would go here later (platform-owned):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

API_SYNC_WAIT_MS=8000
PROVIDER_TIMEOUT_MS=20000
# must be greater than PROVIDER_TIMEOUT_MS; keep identical for the API and the worker (stale-row threshold = 2x)
LOCK_DURATION_MS=35000
MAX_ATTEMPTS=4
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=60000
MAX_RATE_LIMIT_HITS=10
WORKER_CONCURRENCY=5

# API protection - in-process (single instance); a shared store is needed for multi-instance production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_TENANT=300
# failed authentications per IP per window
RATE_LIMIT_MAX_UNAUTH_PER_IP=30
MAX_INFLIGHT_WAITS_PER_TENANT=10
MAX_INFLIGHT_WAITS_GLOBAL=100

# Input / workload limits
BODY_LIMIT_BYTES=102400
MAX_QUESTION_CHARS=4000
MAX_TARGETS_PER_REQUEST=20
MAX_BRANDS=100
MAX_ALIASES_PER_BRAND=50
MAX_TOTAL_ALIASES=500

# Tests only (not read by the app): REQUIRE_REDIS=true (or `npm run test:ci`) makes Redis-backed integration
# suites FAIL instead of being skipped when Redis is unreachable. TEST_REDIS_URL optionally overrides the test Redis.
# REQUIRE_REDIS=false
